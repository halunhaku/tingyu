+  bridge->AddFlutterSemanticsNodeUpdate(detached);
+  bridge->CommitUpdates();
+  EXPECT_TRUE(bridge->GetTree()->error().empty());
+  EXPECT_NE(bridge->GetTree()->GetFromId(1), nullptr);
+  EXPECT_EQ(bridge->GetTree()->GetFromId(2), nullptr);
+  child.label = "updated child";
+  bridge->AddFlutterSemanticsNodeUpdate(child);
+  bridge->CommitUpdates();
+  EXPECT_TRUE(bridge->GetTree()->error().empty());
+  EXPECT_EQ(bridge->GetFlutterPlatformNodeDelegateFromID(1).lock()->GetName(),
+            "updated child");
+}
