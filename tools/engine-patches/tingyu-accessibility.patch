+TEST(AccessibilityBridgeTest, IgnoresUpdatesDetachedBySameFrame) {
+  auto bridge = std::make_shared<TestAccessibilityBridge>();
+  std::vector<int32_t> children{1, 2};
+  auto root = CreateSemanticsNode(0, "root", &children);
+  auto child = CreateSemanticsNode(1, "visible child");
+  auto detached = CreateSemanticsNode(2, "old route");
+  bridge->AddFlutterSemanticsNodeUpdate(root);
+  bridge->AddFlutterSemanticsNodeUpdate(child);
+  bridge->AddFlutterSemanticsNodeUpdate(detached);
+  bridge->CommitUpdates();
+  children = {1};
